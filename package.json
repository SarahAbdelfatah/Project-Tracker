    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
